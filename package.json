{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "node node_modules/vite/bin/vite.js",
        "build": "node node_modules/vite/bin/vite.js build",
        "build:mobile": "node node_modules/vite/bin/vite.js build --config vite.config.mobile.js && node node_modules/@capacitor/cli/bin/capacitor sync android",
        "cap:sync": "node node_modules/@capacitor/cli/bin/capacitor sync android",
        "cap:open": "node node_modules/@capacitor/cli/bin/capacitor open android"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^26.6.5",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "typescript": "^7.0.2",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@capacitor/android": "^8.5.3",
        "@capacitor/cli": "^8.5.3",
        "@capacitor/core": "^8.5.3",
        "@capacitor/preferences": "^8.0.1",
        "@capacitor/status-bar": "^8.0.4",
        "@vitejs/plugin-vue": "^6.0.10",
        "pinia": "^4.0.3",
        "sql.js": "^1.14.2",
        "vue": "^3.5.44",
        "vue-router": "^5.4.0"
    }
}
